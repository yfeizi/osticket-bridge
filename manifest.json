{
  "manifest_version": 3,
  "name": "osTicket → GitLab / GitHub Issue",
  "version": "1.6.0",
  "description": "Create a GitLab or GitHub issue — with attachments and a link-back note — from the osTicket ticket you are viewing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Create an issue from this ticket",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
